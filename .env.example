# 环境变量说明（本文件为模板，不含真实密钥；真实值通过 GitHub Secrets 注入）
# 复制为 .env.local 本地调试用；构建时由 GitHub Actions 从 Secrets 读取

# 后端 API 基础地址：留空或设为 /mock 走内置 Mock 引擎；接真实后端时填后端地址
VITE_API_BASE=/mock

# 管理后台站点部署子路径（GitHub Pages 项目页通常为仓库名，如 /dsh-admin/）
VITE_BASE_PATH=./

# 会话超时（分钟）
VITE_SESSION_TIMEOUT=30

# 看板短轮询降级间隔（毫秒）
VITE_POLL_INTERVAL=15000
